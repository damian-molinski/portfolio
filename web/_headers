# Parsed by Cloudflare Pages and dropped from the deployment — this file is never served.
# Applies to static assets only: /api/contact is a Pages Function and these rules do not reach it.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()

# Renamed on every build by tool/hash_assets.dart, so the URL changes whenever the bytes do.
# One glob per extension rather than `/main.client.*`, which would also match the source map — an
# unhashed file, and two rules setting one header append rather than override.
/main.client.*.js
  Cache-Control: public, max-age=31536000, immutable

/main.client.*.mjs
  Cache-Control: public, max-age=31536000, immutable

/main.client.*.wasm
  Cache-Control: public, max-age=31536000, immutable

# Stable names, so these revalidate — a day of staleness on an image costs nothing.
/images/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400

# HTML – always revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate